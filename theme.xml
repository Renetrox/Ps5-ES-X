<theme>
    <formatVersion>3</formatVersion>

    <!-- Usar la misma imagen para todos los sistemas -->
    <view name="system, basic, detailed, video">
        <image name="logo">
            <path>./_inc/caratulas/${system.theme}.png</path>
        </image>
        <image name="background_system_image" extra="true">
            <path>./_inc/images/background.png</path>
        </image>
    </view>

    <!-- Incluir configuraciones globales y avatar -->
    <include>./Swatch.xml</include>
    <include>./avatar.xml</include>
    <include>./play.xml</include>

    <!-- Mantener systemInfo definido pero fuera de cuadro para evitar el fallback de ES-X -->
    <view name="system">
        <text name="systemInfo">
            <origin>0 0</origin>
            <pos>1.50 1.50</pos>
            <size>0.683 0.035</size>
            <fontPath>./_inc/fonts/SSTLight.TTF</fontPath>
            <fontSize>0.015</fontSize>
            <color>FFFFFFFF</color>
            <alignment>left</alignment>
            <zIndex>0</zIndex>
        </text>
    </view>
</theme>
